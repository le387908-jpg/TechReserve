# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP_API_URL: Endpoint HTTP ou Webhook para disparo de alertas via WhatsApp (usado pelo proxy server-side /api/whatsapp/send)
# Exemplos suportados:
# - Evolution API: https://sua-instancia.com/message/sendText/techreserve
# - Meta Cloud API: https://graph.facebook.com/v21.0/SEU_PHONE_NUMBER_ID/messages
# - Webhook genérico (n8n, Make, Zapier, Z-API): https://seu-webhook.com/whatsapp
WHATSAPP_API_URL=""

# WHATSAPP_API_TOKEN: Token de autenticação (Bearer / apikey) mantido exclusivamente no servidor
WHATSAPP_API_TOKEN=""

# WHATSAPP_PROVIDER: Formato do payload de saída ("WEBHOOK" | "META_CLOUD" | "EVOLUTION")
WHATSAPP_PROVIDER="WEBHOOK"

# Opcionais no front-end Vite (usados pelo whatsappService.ts caso a aplicação rode sem o proxy /api/whatsapp/send):
VITE_WHATSAPP_PROXY_URL="/api/whatsapp/send"
VITE_WHATSAPP_API_URL=""
VITE_WHATSAPP_PROVIDER="WEBHOOK"
