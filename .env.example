# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP_API_URL: URL base ou endpoint HTTP/Webhook para disparo de alertas via WhatsApp (usado pelo proxy server-side /api/whatsapp/*)
# Exemplos suportados:
# - Evolution API (URL base ou endpoint completo): https://sua-instancia-evolution.com
# - Meta Cloud API: https://graph.facebook.com/v21.0/SEU_PHONE_NUMBER_ID/messages
# - Webhook genérico (n8n, Make, Zapier, Z-API): https://seu-webhook.com/whatsapp
WHATSAPP_API_URL=""

# WHATSAPP_API_TOKEN: Token / Global API Key mantido exclusivamente no servidor
WHATSAPP_API_TOKEN=""

# WHATSAPP_PROVIDER: Provedor ("EVOLUTION" | "META_CLOUD" | "WEBHOOK")
WHATSAPP_PROVIDER="EVOLUTION"

# WHATSAPP_INSTANCE: Nome da instância na Evolution API (padrão: "techreserve")
WHATSAPP_INSTANCE="techreserve"

# Opcionais no front-end Vite:
VITE_WHATSAPP_PROXY_URL="/api/whatsapp/send"
VITE_WHATSAPP_API_URL=""
VITE_WHATSAPP_PROVIDER="EVOLUTION"
